<?xml version="1.0" encoding="UTF-8"?>
<!-- Cairn resource bundle. The resource-pipeline paradigm: an app asset carried
     the symbolic way (a currentColor SVG under the freedesktop icon-theme shape)
     so set_icon_name("composix-logo-symbolic") resolves it out of the compiled-in
     binary and GTK recolours it to the theme foreground -- no icon installed on
     the user's disk.

     Gotcha the shape encodes: GTK's icon lookup is RIGID about the trailing
     .../scalable/apps/ path, so the prefix ends there and App::on_activate
     passes only /io/github/scott8420/Composix/icons to add_resource_path (GTK appends
     scalable/apps/ itself). The prefix mirrors the app-id; both move together in
     a one-pass rename. See docs/resources-and-dialog-lifetime.md. -->
<gresources>
  <gresource prefix="/io/github/scott8420/Composix/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="composix-logo-symbolic.svg">icons/scalable/apps/composix-logo-symbolic.svg</file>
    <!-- s008: tool icons Adwaita lacks (a pointer, a shape), same symbolic style -->
    <file preprocess="xml-stripblanks" alias="composix-tool-select-symbolic.svg">icons/scalable/apps/composix-tool-select-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="composix-tool-shape-symbolic.svg">icons/scalable/apps/composix-tool-shape-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="composix-tool-rect-symbolic.svg">icons/scalable/apps/composix-tool-rect-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="composix-tool-oval-symbolic.svg">icons/scalable/apps/composix-tool-oval-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="composix-tool-line-symbolic.svg">icons/scalable/apps/composix-tool-line-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="composix-tool-pen-symbolic.svg">icons/scalable/apps/composix-tool-pen-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="composix-tool-polygon-symbolic.svg">icons/scalable/apps/composix-tool-polygon-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="composix-tool-eyedropper-symbolic.svg">icons/scalable/apps/composix-tool-eyedropper-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="composix-tool-zoom-symbolic.svg">icons/scalable/apps/composix-tool-zoom-symbolic.svg</file>
    <!-- s186: the Direct tool (a hollow pointer) -->
    <file preprocess="xml-stripblanks" alias="composix-tool-direct-symbolic.svg">icons/scalable/apps/composix-tool-direct-symbolic.svg</file>
    <!-- s115: the Footnotes section -->
    <file preprocess="xml-stripblanks" alias="composix-footnote-symbolic.svg">icons/scalable/apps/composix-footnote-symbolic.svg</file>
  </gresource>
  <!-- s002: the app stylesheet, loaded by App::on_activate at APPLICATION
       priority (docs/look.md). -->
  <gresource prefix="/io/github/scott8420/Composix">
    <file>composix.css</file>
  </gresource>
</gresources>
